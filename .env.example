# Copia este archivo como ".env" (sin la palabra example) y pega tu clave.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
GEMINI_API_KEY=pega_aqui_tu_clave

# Opcional: cambiar el modelo si Google renombra el actual.
# GEMINI_MODEL=gemini-3.8-flash

# Opcional: forzar el modo simulado (sin IA) aunque exista la clave.
# LLM_PROVIDER=simulado

# --- Solo al publicar la aplicación en internet (ver DESPLIEGUE.md) ---
# Activa las cookies seguras (HTTPS) y apaga el modo de depuración.
# PRODUCCION=1
# Clave que firma las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=pega_aqui_la_clave_generada
